{
  "name": "attribution-platform-backend",
  "version": "1.0.0",
  "description": "Backend API for the Attribution Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node src/db/migrate.ts",
    "seed:demo": "ts-node src/scripts/seed-demo.ts",
    "seed:clean": "ts-node src/scripts/seed-demo.ts clean",
    "migrate:prod": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "fx:sync": "ts-node src/scripts/fx-sync.ts",
    "attribution:rebuild": "ts-node src/scripts/rebuild-attribution.ts",
    "amo:import": "ts-node src/scripts/amo-import.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vercel/functions": "^3.9.7",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.5.0",
    "pg": "^8.22.0",
    "redis": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
