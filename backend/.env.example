# ============================================================
# Attribution Platform — backend environment variables
# Copy to .env for local dev. In production (Railway) set these
# in the service Variables tab. Never commit the real .env.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development                 # set to "production" on Railway

# --- PostgreSQL ---
# Railway: use the PostgreSQL plugin's DATABASE_URL reference.
DATABASE_URL=postgresql://postgres:password@localhost:5432/attribution_db
PGHOST=localhost                     # optional fallback if DATABASE_URL unset
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=attribution_db
# PGSSL=true                         # set true for managed PG (Supabase, etc.)

# --- Redis (Bull queue + dashboard cache) ---
# Railway: use the Redis plugin's REDIS_URL reference.
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string   # 48+ random chars in prod
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- CORS / Frontend ---
# Production frontend origin (Vercel URL). CORS is locked to this in prod.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Facebook OAuth / Marketing API ---
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
# In prod: https://api.yourdomain.com/api/auth/facebook/callback
FB_REDIRECT_URI=http://localhost:4000/api/auth/facebook/callback

# --- AES-256 token encryption (any secret; hashed to 32 bytes) ---
ENCRYPTION_KEY=32-character-random-string-here!!

# --- AmoCRM OAuth + webhook ---
AMOCRM_CLIENT_ID=your_integration_id
AMOCRM_CLIENT_SECRET=your_client_secret
# In prod: https://api.yourdomain.com/api/auth/amocrm/callback
AMOCRM_REDIRECT_URI=http://localhost:4000/api/auth/amocrm/callback
AMOCRM_WEBHOOK_SECRET=random_verification_string

# ============================================================
# VERCEL SERVERLESS (Railway'da kerak emas)
# ============================================================

# --- Tashqi cron tetigi ---
# Serverless'da node-cron ishlamaydi. Sync tashqi rejalashtiruvchidan keladi:
#   POST https://<backend>.vercel.app/api/sync/cron
#   Header: X-Cron-Secret: <shu qiymat>
# Bo'sh qoldirilsa endpoint 503 qaytaradi (ochiq qolmaydi).
CRON_SECRET=uzun_tasodifiy_satr_shu_yerga

# --- Doimiy serverda ichki cron'ni o'chirish (ixtiyoriy) ---
# DISABLE_SYNC_CRON=true

# --- Webhook muddati (ms) ---
# amoCRM webhook'i shu vaqtgacha ishni tugatishga urinadi, keyin 200 qaytaradi
# va qolganini waitUntil ushlab qoladi.
WEBHOOK_DEADLINE_MS=8000

# --- CORS: bir nechta frontend manzili ---
# FRONTEND_URL vergul bilan ajratilgan ro'yxatni qabul qiladi:
#   FRONTEND_URL=https://app.example.com,https://staging.example.com
# Vercel preview deploy'lariga ruxsat berish (faqat dev/staging uchun):
# ALLOW_VERCEL_PREVIEWS=true

# ============================================================
# ⚠ SUPABASE POOLER — SERVERLESS UCHUN MUHIM
# ============================================================
# Serverless'da SESSION pooler (port 5432) ishlatilmaydi — har sovuq start
# ulanishni butun sessiya davomida ushlab qoladi va limit tez tugaydi.
# DATABASE_URL ni TRANSACTION pooler'ga qarating:
#
#   postgresql://postgres.<ref>:<parol>@aws-0-<region>.pooler.supabase.com:6543/postgres
#                                                                          ^^^^
# Parolni URL-encode qiling. Pool o'zi max:1 ga tushadi (src/db/pool.ts).
